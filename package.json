{
  "name": "dsh-persona-memory",
  "version": "1.1.0",
  "description": "DSH 插件合集：人格蒸馏 + 日记 + 会遗忘的记忆",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "memory",
    "journal",
    "distill",
    "forget",
    "recall"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "journal": "node journal-cli.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./journal": "./journal.js",
    "./journal-cli": "./journal-cli.mjs",
    "./package.json": "./package.json",
    "./life-memory": "./life-memory/index.js"
  },
  "files": [
    "index.js",
    "client.js",
    "journal.js",
    "journal-cli.mjs",
    "life-memory",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
